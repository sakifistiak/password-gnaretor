{
  "manifest_version": 3,
  "name": "KeyForge - Secure Password Generator",
  "version": "1.0.0",
  "description": "Cryptographically secure password & passphrase generator with entropy metrics, HIBP k-anonymity breach checks, and smart page autofill.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KeyForge Password Generator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.pwnedpasswords.com/*"
  ]
}
